    "@hugeicons/react": "^1.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "groq-sdk": "^1.6.0",
    "highlight.js": "^11.12.0",
